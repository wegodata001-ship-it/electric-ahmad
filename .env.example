# =============================================================================
# Environment variables template.
# Copy to `.env.local` (development) or configure in your production secret
# store, then fill in real values. NEVER commit real secrets.
#
# Validation runs at server startup via src/instrumentation.ts. See
# src/lib/env/required-secrets.ts for the exact rules.
# =============================================================================

# --- Required always -------------------------------------------------------
# Long, random string (>= 32 chars). Used to HMAC-sign office + field session
# cookies. Rotate = invalidate all sessions. NEVER use a placeholder value
# containing "change-me" — startup will refuse to boot.
SESSION_SECRET=

# Postgres connection string used by Prisma.
DATABASE_URL=

# --- Required when Supabase is used ----------------------------------------
# If ANY of the three below is set, ALL of them must be set.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional bucket overrides (defaults are hardcoded in src/config/storage.ts).
# SUPABASE_BUCKET_PROJECTS=
# SUPABASE_BUCKET_CONTRACTS=
# SUPABASE_BUCKET_BOQ=
# SUPABASE_BUCKET_PARTIAL_INVOICES=
# SUPABASE_BUCKET_DOCUMENTS=
# SUPABASE_BUCKET_IMAGES=
# SUPABASE_BUCKET_VIDEOS=
# SUPABASE_BUCKET_REPORTS=
# SUPABASE_BUCKET_EXCEL=
# SUPABASE_BUCKET_PDF=
# SUPABASE_BUCKET_DELIVERY_NOTES=

# --- Observability (required for Production gate) --------------------------
# Create a Sentry project and paste DSNs. Without these, error tracking is off.
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_RELEASE=
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.05

# --- Optional integrations -------------------------------------------------
# Set only when the corresponding feature is enabled. If set, the value must
# NOT be a placeholder ("change-me" etc.) — startup validation will reject it.
GEMINI_API_KEY=
OPENAI_API_KEY=
SMTP_PASSWORD=
NEXTAUTH_SECRET=
JWT_SECRET=
CRON_SECRET=

# Accepted only as an alias for SESSION_SECRET when SESSION_SECRET is unset.
# Prefer SESSION_SECRET; leave AUTH_SECRET blank unless you have a reason.
AUTH_SECRET=
