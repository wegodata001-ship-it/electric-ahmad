{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "regions": ["arn1"],
  "crons": [
    {
      "path": "/api/cron/ai-scan-jobs",
      "schedule": "* * * * *"
    }
  ],
  "git": {
    "deploymentEnabled": {
      "master": true,
      "main": true
    }
  }
}
