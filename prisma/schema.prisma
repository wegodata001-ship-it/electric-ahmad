generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/** Key/value system settings (e.g. attendance policy) */
model AppConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ProjectStatus {
  active
  completed
  on_hold
  planning
}

enum BoqItemStatus {
  active
  pending
  cancelled
  completed
  // Legacy — kept for existing rows until migrated
  not_started
  in_progress
  on_hold
}

enum BoqItemKind {
  regular
  exceptional
}

enum ExecutionStatus {
  not_started
  in_progress
  partially_completed
  completed
  finished
  pending_approval
  approved
  rejected
  cancelled
}

enum EmployeeStatus {
  active
  inactive
  on_leave
}

enum EmployeeRole {
  worker
  foreman
  engineer
  manager
  admin
}

enum DocumentType {
  pdf
  excel
  word
  dwg
  image
  video
  other
}

enum InvoiceStatus {
  draft
  pending_foreman_approval
  approved_by_foreman
  rejected_by_foreman
  sent_to_client
  signed
  paid
  // Legacy values kept for backward compatibility with existing rows
  submitted
  approved
  rejected
}

enum MeasurementAxisType {
  room
  floor
  building
  area
  custom
}

enum MeasurementSheetStatus {
  draft
  in_progress
  pending_approval
  revision
  approved
  locked
  invoiced
}

enum InvoiceApprovalStatus {
  pending
  approved
  rejected
  cancelled
}

enum NotificationType {
  report
  item_completed
  document
  invoice
  system
  employee
}

enum ActivityType {
  report_created
  quantity_updated
  document_uploaded
  invoice_created
  status_changed
  employee_assigned
  project_updated
  delivery_note_created
}

enum MediaType {
  image
  video
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  UPLOAD
}

// ─── Users ───────────────────────────────────────────────────────────────────

model User {
  id           String   @id @default(cuid())
  supabaseId   String?  @unique
  email        String   @unique
  /** Login username for field managers (and future roles) */
  username     String?  @unique
  passwordHash String?
  name         String
  /** FIELD_MANAGER | admin | office roles… */
  role         String   @default("admin")
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  employee Employee?

  ownedProjects     Project[]  @relation("ProjectOwner")
  createdProjects   Project[]  @relation("ProjectCreatedBy")
  updatedProjects   Project[]  @relation("ProjectUpdatedBy")
  createdBoqItems   BoqItem[]  @relation("BoqCreatedBy")
  updatedBoqItems   BoqItem[]  @relation("BoqUpdatedBy")
  deletedBoqItems   BoqItem[]  @relation("BoqDeletedBy")
  createdReports    WorkReport[] @relation("ReportCreatedBy")
  updatedReports    WorkReport[] @relation("ReportUpdatedBy")
  uploadedDocuments Document[] @relation("DocumentUploadedBy")
  createdDocuments  Document[] @relation("DocumentCreatedBy")
  updatedDocuments  Document[] @relation("DocumentUpdatedBy")
  uploadedDocumentAttachments DocumentAttachment[] @relation("DocumentAttachmentUploadedBy")
  uploadedGallery   GalleryItem[] @relation("GalleryUploadedBy")
  createdInvoices   PartialInvoice[] @relation("InvoiceCreatedBy")
  updatedInvoices   PartialInvoice[] @relation("InvoiceUpdatedBy")
  createdApprovals  ProjectInvoiceApproval[] @relation("ApprovalCreatedBy")
  assignedInvoiceApprovals ProjectInvoiceApproval[] @relation("InvoiceApproverUser")
  createdDeliveryNotes  DeliveryNote[] @relation("DeliveryNoteCreatedBy")
  updatedDeliveryNotes  DeliveryNote[] @relation("DeliveryNoteUpdatedBy")
  deliveryNoteVersions  DeliveryNoteVersion[] @relation("DeliveryNoteVersionEditedBy")
  activities        Activity[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  officeAttendances OfficeAttendance[]
  attendanceDevices AttendanceDevice[]
  createdExecutions BoqExecution[] @relation("ExecutionCreatedBy")
  updatedExecutions BoqExecution[] @relation("ExecutionUpdatedBy")
  executionComments BoqExecutionComment[]
  executionHistory  BoqExecutionHistory[]
  createdExecutionReports ExecutionReport[] @relation("ExecutionReportCreatedBy")
  updatedExecutionReports ExecutionReport[] @relation("ExecutionReportUpdatedBy")

  // Work diary + ops delivery notes (new module)
  createdWorkDiaries       WorkDiary[]              @relation("WorkDiaryCreatedBy")
  updatedWorkDiaries       WorkDiary[]              @relation("WorkDiaryUpdatedBy")
  workDiaryApprovals       WorkDiaryApproval[]      @relation("WorkDiaryApprover")
  workDiaryEvents          WorkDiaryEvent[]         @relation("WorkDiaryEventActor")
  createdOpsDeliveryNotes  OpsDeliveryNote[]        @relation("OpsDnCreatedBy")
  updatedOpsDeliveryNotes  OpsDeliveryNote[]        @relation("OpsDnUpdatedBy")
  opsDnApprovals           OpsDeliveryNoteApproval[] @relation("OpsDnApprover")
  opsDnEvents              OpsDeliveryNoteEvent[]   @relation("OpsDnEventActor")
  projectDefaultApprovers  ProjectDefaultApprover[]
  createdMeasurementSheets MeasurementSheet[] @relation("MeasurementSheetCreatedBy")
  updatedMeasurementSheets MeasurementSheet[] @relation("MeasurementSheetUpdatedBy")
  measurementEntries       MeasurementEntry[] @relation("MeasurementEntryActor")
  measurementSheetApprovals MeasurementSheetApproval[] @relation("MeasurementSheetApprover")
  measurementSheetEvents    MeasurementSheetEvent[]    @relation("MeasurementSheetEventActor")
  measurementSheetReviewNotes MeasurementSheetReviewNote[] @relation("MeasurementSheetReviewAuthor")

  // Central Workflow Engine (Stage 1)
  ownedWorkflowDocuments    WorkflowDocument[] @relation("WorkflowDocumentOwner")
  createdWorkflowDocuments  WorkflowDocument[] @relation("WorkflowDocumentCreatedBy")
  updatedWorkflowDocuments  WorkflowDocument[] @relation("WorkflowDocumentUpdatedBy")
  workflowApprovals         WorkflowApproval[] @relation("WorkflowApprover")
  workflowEvents            WorkflowEvent[]    @relation("WorkflowEventActor")
  workflowOverrides         WorkflowOverride[] @relation("WorkflowOverrideActor")
  workflowAttachmentsUploaded WorkflowAttachment[] @relation("WorkflowAttachmentUploadedBy")
}

// ─── Employees ───────────────────────────────────────────────────────────────

model Employee {
  id                String         @id @default(cuid())
  firstName         String
  lastName          String
  phone             String
  email             String         @unique
  role              EmployeeRole
  status            EmployeeStatus @default(active)
  /** Soft delete — history retained */
  isDeleted         Boolean        @default(false)
  deletedAt         DateTime?
  notes             String?
  avatarUrl         String?
  avatarPath        String?
  avatarBucket      String?
  completedQuantity Int            @default(0)
  openQuantity      Int            @default(0)
  joinedAt          DateTime
  userId            String?        @unique
  user              User?          @relation(fields: [userId], references: [id])
  /** Infrastructure flag — create system user later (manager workspace) */
  wantsSystemUser   Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  foremanProjects Project[]         @relation("ProjectForeman")
  projectLinks    ProjectEmployee[]
  reports         WorkReport[]
  galleryItems    GalleryItem[]
  invoiceApprovals ProjectInvoiceApproval[]
  executionsAsWorker  BoqExecution[] @relation("ExecutionWorker")
  executionsAsForeman BoqExecution[] @relation("ExecutionForeman")
  fieldCrewMembers    FieldCrewMember[]
  fieldAttendances    FieldAttendance[]
  executionReports    ExecutionReport[] @relation("ReportForeman")
  workOrders          WorkOrder[]       @relation("WorkOrderForeman")
  workDiaries         WorkDiary[]       @relation("WorkDiaryForeman")
  opsDeliveryNotes    OpsDeliveryNote[] @relation("OpsDnForeman")

  @@index([isDeleted])
}

model ProjectEmployee {
  projectId  String
  employeeId String
  assignedAt DateTime @default(now())

  project  Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@id([projectId, employeeId])
  @@index([employeeId])
}

// ─── Projects ──────────────────────────────────────────────────────────────────

model Project {
  id             String        @id @default(cuid())
  name           String
  contractNumber String        @unique
  contractor     String
  location       String
  foremanId      String
  foreman        Employee      @relation("ProjectForeman", fields: [foremanId], references: [id])
  status         ProjectStatus @default(active)
  contractValue  Decimal       @db.Decimal(14, 2)
  completedValue Decimal       @default(0) @db.Decimal(14, 2)
  invoicedValue  Decimal       @default(0) @db.Decimal(14, 2)
  progress       Float         @default(0)
  financialProgress Float      @default(0)
  subtotal       Decimal?      @db.Decimal(14, 2)
  vatPercent     Decimal?      @db.Decimal(5, 2)
  vatAmount      Decimal?      @db.Decimal(14, 2)
  totalWithVat   Decimal?      @db.Decimal(14, 2)
  imageUrl       String?
  imagePath      String?
  imageBucket    String?
  startDate      DateTime
  endDate        DateTime
  description    String?
  /** ציר יחידות לדפי מדידה: חדר / קומה / בניין / אזור */
  measurementAxisType  MeasurementAxisType @default(room)
  measurementAxisLabel String?
  ownerId        String
  owner          User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  createdById    String
  createdBy      User          @relation("ProjectCreatedBy", fields: [createdById], references: [id])
  updatedById    String
  updatedBy      User          @relation("ProjectUpdatedBy", fields: [updatedById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  boqItems      BoqItem[]
  reports       WorkReport[]
  documents     Document[]
  invoices      PartialInvoice[]
  invoiceApprovals ProjectInvoiceApproval[]
  deliveryNotes DeliveryNote[]
  executions    BoqExecution[]
  activities    Activity[]
  employees     ProjectEmployee[]
  galleryItems  GalleryItem[]
  notifications Notification[]
  fieldAttendances FieldAttendance[]
  executionReports ExecutionReport[]
  workOrders       WorkOrder[]
  workDiaries      WorkDiary[]
  opsDeliveryNotes OpsDeliveryNote[]
  defaultApprovers ProjectDefaultApprover[]
  measurementSheets MeasurementSheet[]
  workflowDocuments WorkflowDocument[]
  rooms             ProjectRoom[]

  @@index([status])
  @@index([foremanId])
  @@index([ownerId])
}

/** חדר / יחידה ברמת פרויקט — מקור אמת משותף לכל המסכים */
model ProjectRoom {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  floor     String?
  code      String?
  sortOrder Int       @default(0)
  isHidden  Boolean   @default(false)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  sheetRows MeasurementSheetRow[]

  @@index([projectId, sortOrder])
  @@index([projectId, deletedAt])
}

// ─── BOQ ─────────────────────────────────────────────────────────────────────

model BoqItem {
  id                String        @id @default(cuid())
  projectId         String
  project           Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  code              String
  description       String
  unit              String
  contractQuantity  Decimal       @db.Decimal(12, 4)
  completedQuantity Decimal       @default(0) @db.Decimal(12, 4) // executed / ביצוע בפועל
  invoicedQuantity  Decimal       @default(0) @db.Decimal(12, 4) // חויב בחשבונות
  remainingQuantity Decimal       @default(0) @db.Decimal(12, 4) // חוזה - בוצע
  unitPrice         Decimal       @db.Decimal(12, 2)
  completedValue    Decimal       @default(0) @db.Decimal(14, 2)
  remainingValue    Decimal       @default(0) @db.Decimal(14, 2)
  progress          Float         @default(0)
  /** סטטוס ניהולי — לא קשור לדיווח כמויות */
  status            BoqItemStatus @default(active)
  /** רגיל מהתוכנית / חריג שנוסף במהלך העבודה */
  itemKind          BoqItemKind   @default(regular)
  category          String?
  notes             String?
  parentId          String?
  parent            BoqItem?      @relation("BoqHierarchy", fields: [parentId], references: [id])
  children          BoqItem[]     @relation("BoqHierarchy")
  level             Int           @default(0)
  deletedAt         DateTime?
  deletedById       String?
  deletedBy         User?         @relation("BoqDeletedBy", fields: [deletedById], references: [id])
  createdById       String
  createdBy         User          @relation("BoqCreatedBy", fields: [createdById], references: [id])
  updatedById       String
  updatedBy         User          @relation("BoqUpdatedBy", fields: [updatedById], references: [id])
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  reports      WorkReport[]
  invoiceItems InvoiceItem[]
  galleryItems GalleryItem[]
  executions   BoqExecution[]
  executionReportItems ExecutionReportItem[]
  measurementCells MeasurementCell[]

  @@index([projectId])
  @@index([code])
  @@index([status])
  @@index([itemKind])
  @@index([deletedAt])
}

// ─── BOQ Executions (central field-performance entity) ─────────────────────────

model BoqExecution {
  id           String          @id @default(cuid())
  projectId    String
  project      Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItemId    String
  boqItem      BoqItem         @relation(fields: [boqItemId], references: [id])
  employeeId   String
  employee     Employee        @relation("ExecutionWorker", fields: [employeeId], references: [id])
  foremanId    String?
  foreman      Employee?       @relation("ExecutionForeman", fields: [foremanId], references: [id])
  quantity     Decimal         @db.Decimal(12, 4)
  executedAt   DateTime
  status       ExecutionStatus @default(in_progress)
  notes        String?
  source       String          @default("office") // office | field | system | legacy
  workReportId String?         @unique
  workReport   WorkReport?     @relation(fields: [workReportId], references: [id], onDelete: SetNull)
  createdById  String
  createdBy    User            @relation("ExecutionCreatedBy", fields: [createdById], references: [id])
  updatedById  String
  updatedBy    User            @relation("ExecutionUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  media       BoqExecutionMedia[]
  attachments BoqExecutionAttachment[]
  comments    BoqExecutionComment[]
  history     BoqExecutionHistory[]

  @@index([projectId])
  @@index([boqItemId])
  @@index([employeeId])
  @@index([foremanId])
  @@index([executedAt])
  @@index([status])
}

model BoqExecutionMedia {
  id            String       @id @default(cuid())
  executionId   String
  execution     BoqExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  type          MediaType
  name          String
  extension     String
  size          Int
  bucket        String
  path          String
  url           String
  thumbnailUrl  String?
  thumbnailPath String?
  createdAt     DateTime     @default(now())

  @@index([executionId])
}

model BoqExecutionAttachment {
  id          String       @id @default(cuid())
  executionId String
  execution   BoqExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  name        String
  mimeType    String
  size        Int
  kind        String       @default("document")
  bucket      String
  path        String
  url         String
  createdAt   DateTime     @default(now())

  @@index([executionId])
}

model BoqExecutionComment {
  id          String       @id @default(cuid())
  executionId String
  execution   BoqExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  body        String
  createdAt   DateTime     @default(now())

  @@index([executionId])
}

model BoqExecutionHistory {
  id          String           @id @default(cuid())
  executionId String
  execution   BoqExecution     @relation(fields: [executionId], references: [id], onDelete: Cascade)
  action      String
  fromStatus  ExecutionStatus?
  toStatus    ExecutionStatus?
  quantity    Decimal?         @db.Decimal(12, 4)
  metadata    String?
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  createdAt   DateTime         @default(now())

  @@index([executionId])
  @@index([createdAt])
}

// ─── Work Reports ──────────────────────────────────────────────────────────────

model WorkReport {
  id          String   @id @default(cuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  boqItemId   String
  boqItem     BoqItem  @relation(fields: [boqItemId], references: [id])
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id])
  quantity    Decimal  @db.Decimal(12, 4)
  notes       String?
  reportedAt  DateTime
  createdById String
  createdBy   User     @relation("ReportCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User     @relation("ReportUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  media        ReportMedia[]
  galleryItems GalleryItem[]
  execution    BoqExecution?

  @@index([projectId])
  @@index([boqItemId])
  @@index([employeeId])
  @@index([reportedAt])
}

model ReportMedia {
  id           String    @id @default(cuid())
  reportId     String
  report       WorkReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type         MediaType
  name         String
  extension    String
  size         Int
  bucket       String
  path         String
  url          String
  thumbnailUrl String?
  thumbnailPath String?
  createdAt    DateTime  @default(now())

  @@index([reportId])
}

// ─── Documents ─────────────────────────────────────────────────────────────────

model Document {
  id           String       @id @default(cuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name         String
  type         DocumentType
  extension    String
  size         Int
  bucket       String
  path         String
  url          String
  version      Int          @default(1)
  /** נתיב תיקייה לוגית במסמכים, לדוגמה: דוחות ביצוע / תמונות */
  folderPath   String?
  /** קישור לישות מקור (measurement_sheet, delivery_note, partial_invoice, ...) */
  sourceType   String?
  sourceId     String?
  /** קישור למסמך Workflow — ארכיון Documents כמראה של אותו מסמך */
  workflowDocumentId String? @unique
  workflowDocument   WorkflowDocument? @relation(fields: [workflowDocumentId], references: [id], onDelete: SetNull)
  /** מזהה GalleryItem ישן אחרי מיגרציה — למניעת כפילות */
  legacyGalleryId String?   @unique
  boqItemId    String?
  employeeId   String?
  reportId     String?
  partialInvoiceId String?
  partialInvoice   PartialInvoice? @relation(fields: [partialInvoiceId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User         @relation("DocumentUploadedBy", fields: [uploadedById], references: [id])
  ownerId      String
  createdById  String
  createdBy    User         @relation("DocumentCreatedBy", fields: [createdById], references: [id])
  updatedById  String
  updatedBy    User         @relation("DocumentUpdatedBy", fields: [updatedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  versions    DocumentVersion[]
  attachments DocumentAttachment[]

  @@index([projectId])
  @@index([type])
  @@index([folderPath])
  @@index([partialInvoiceId])
  @@index([sourceType, sourceId])
}

model DocumentAttachment {
  id           String       @id @default(cuid())
  documentId   String
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name         String
  type         DocumentType
  extension    String
  size         Int
  bucket       String
  path         String
  url          String
  uploadedById String
  uploadedBy   User         @relation("DocumentAttachmentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())

  @@index([documentId])
  @@index([type])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  document     Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      Int
  size         Int
  bucket       String
  path         String
  url          String
  uploadedById String
  createdAt    DateTime @default(now())

  @@index([documentId])
}

// ─── Partial Invoices ──────────────────────────────────────────────────────────

model PartialInvoice {
  id             String        @id @default(cuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceNumber  String        @unique
  sequenceNumber Int           @default(1)
  billingMonth   String        @default("")
  billTo         String?
  contractor     String?
  amount         Decimal       @db.Decimal(14, 2)
  subtotal       Decimal?      @db.Decimal(14, 2)
  vatPercent     Decimal?      @db.Decimal(5, 2)
  vatAmount      Decimal?      @db.Decimal(14, 2)
  totalWithVat   Decimal?      @db.Decimal(14, 2)
  status         InvoiceStatus @default(draft)
  date           DateTime
  dueDate        DateTime
  notes          String?
  bucket         String?
  path           String?
  url            String?
  ownerId        String
  createdById    String
  createdBy      User          @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  updatedById    String
  updatedBy      User          @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id])
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  items      InvoiceItem[]
  approvals  ProjectInvoiceApproval[]
  executionReportItems ExecutionReportItem[]
  measurementSheets MeasurementSheet[]
  documents  Document[]

  @@index([projectId, sequenceNumber])
  @@index([projectId])
  @@index([status])
}

/**
 * Invoice approval workflow — office sends to a selected approver user.
 * managerId (Employee) kept optional for backward compatibility with older rows.
 */
model ProjectInvoiceApproval {
  id             String                @id @default(cuid())
  invoiceId      String
  invoice        PartialInvoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  projectId      String
  project        Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /** Legacy / linked employee profile when the approver has one */
  managerId      String?
  manager        Employee?             @relation(fields: [managerId], references: [id])
  /** Selected system user with invoice-approval permission */
  approverUserId String?
  approverUser   User?                 @relation("InvoiceApproverUser", fields: [approverUserId], references: [id])
  status         InvoiceApprovalStatus @default(pending)
  sentAt         DateTime?
  approvedAt     DateTime?
  rejectedAt     DateTime?
  comment        String?
  createdById    String
  createdBy      User                  @relation("ApprovalCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([invoiceId])
  @@index([projectId])
  @@index([managerId])
  @@index([approverUserId])
  @@index([status])
}

model InvoiceItem {
  id                 String         @id @default(cuid())
  invoiceId          String
  invoice            PartialInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  boqItemId          String
  boqItem            BoqItem        @relation(fields: [boqItemId], references: [id])
  code               String
  description        String
  unit               String         @default("יח'")
  contractQuantity   Decimal        @default(0) @db.Decimal(12, 4)
  previousQuantity   Decimal        @default(0) @db.Decimal(12, 4)
  quantity           Decimal        @db.Decimal(12, 4) // current invoice qty
  cumulativeQuantity Decimal        @default(0) @db.Decimal(12, 4)
  quantityPercent    Float          @default(0)
  unitPrice          Decimal        @db.Decimal(12, 2)
  total              Decimal        @db.Decimal(14, 2) // current amount
  cumulativeAmount   Decimal        @default(0) @db.Decimal(14, 2)
  financialPercent   Float          @default(0)

  @@index([invoiceId])
  @@index([boqItemId])
}

// ─── Clients (directory; DN keeps denormalized snapshot strings) ─────────────

model Client {
  id             String   @id @default(cuid())
  clientNumber   String?
  name           String
  companyName    String?
  contactName    String?
  phone          String?
  phoneSecondary String?
  address        String?
  city           String?
  email          String?
  notes          String?
  ownerId        String
  createdById    String
  updatedById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  deliveryNotes DeliveryNote[]

  @@index([name])
  @@index([phone])
  @@index([clientNumber])
  @@index([ownerId])
}

// ─── Delivery Notes (independent module) ─────────────────────────────────────

enum DeliveryNoteStatus {
  draft
  sent
  delivered
  cancelled
  issued
  in_transit
  locked
}

model DeliveryNote {
  id             String             @id @default(cuid())
  noteNumber     String             @unique
  sequenceNumber Int                @default(1)
  status         DeliveryNoteStatus @default(draft)
  date           DateTime
  departureTime  String?
  client         String
  clientId       String?
  clientCard     Client?            @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  orderNumber    String?
  contactName    String?
  phone          String?
  phoneSecondary String?
  address        String?
  city           String?
  notes          String?

  // Transport
  driverName         String?
  driverPhone        String?
  vehicle            String?
  vehicleNumber      String?
  externalCarrier    Boolean  @default(false)
  deliveryTime       String?
  destination        String?
  destinationAddress String?
  driverNotes        String?

  // Signatures
  senderSigned   Boolean   @default(false)
  receiverSigned Boolean   @default(false)
  receiverName   String?
  receivedAt     DateTime?
  /** Digital signature images (data URL or storage URL) */
  receiverSignatureUrl String? @db.Text
  employeeSignatureUrl String? @db.Text
  employeeSignedName   String?

  // Delivery confirmation (legal/ops)
  equipmentCheckedIntact Boolean @default(false)
  receivedComplete       Boolean @default(false)
  receivedWithNotes      Boolean @default(false)
  receiptNotes           String?

  // Future channels / proof of delivery (infra only)
  qrCodePayload    String?
  barcodePayload   String?
  whatsappSentAt   DateTime?
  emailSentAt      DateTime?
  deliveryPhotoUrl String?
  deliveryGpsLat   Float?
  deliveryGpsLng   Float?

  bucket String?
  path   String?
  url    String?

  /** Document revision counter (noteNumber never changes) */
  currentVersion Int @default(1)

  ownerId     String
  createdById String
  createdBy   User     @relation("DeliveryNoteCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User     @relation("DeliveryNoteUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       DeliveryNoteItem[]
  attachments DeliveryNoteAttachment[]
  versions    DeliveryNoteVersion[]

  @@index([projectId])
  @@index([clientId])
  @@index([date])
  @@index([status])
}

/** Edit history for delivery notes — additive, does not alter noteNumber */
model DeliveryNoteVersion {
  id             String       @id @default(cuid())
  deliveryNoteId String
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  version        Int
  /** JSON: [{ field, label, from, to }] */
  changesJson    String       @default("[]")
  /** JSON snapshot of note after this version */
  snapshotJson   String       @default("{}")
  editedById     String
  editedBy       User         @relation("DeliveryNoteVersionEditedBy", fields: [editedById], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([deliveryNoteId, version])
  @@index([deliveryNoteId])
  @@index([createdAt])
}

model DeliveryNoteItem {
  id             String       @id @default(cuid())
  deliveryNoteId String
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  sku            String?
  description    String
  unit           String       @default("יח'")
  quantity       Decimal      @db.Decimal(12, 4)
  packageNumber  String?
  serialNumber   String?
  notes          String?
  sortOrder      Int          @default(0)

  @@index([deliveryNoteId])
}

model DeliveryNoteAttachment {
  id             String       @id @default(cuid())
  deliveryNoteId String
  deliveryNote   DeliveryNote @relation(fields: [deliveryNoteId], references: [id], onDelete: Cascade)
  name           String
  mimeType       String
  size           Int
  kind           String       @default("document") // image | pdf | document
  bucket         String
  path           String
  url            String
  createdAt      DateTime     @default(now())

  @@index([deliveryNoteId])
}

// ─── Gallery ───────────────────────────────────────────────────────────────────

model GalleryItem {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type          MediaType
  title         String
  bucket        String
  path          String
  url           String
  thumbnailUrl  String
  thumbnailPath String?
  boqItemId     String?
  boqItem       BoqItem?  @relation(fields: [boqItemId], references: [id])
  reportId      String?
  report        WorkReport? @relation(fields: [reportId], references: [id])
  employeeId    String?
  employee      Employee? @relation(fields: [employeeId], references: [id])
  uploadedById  String
  uploadedBy    User      @relation("GalleryUploadedBy", fields: [uploadedById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([projectId])
  @@index([type])
}

// ─── Activity & Notifications ──────────────────────────────────────────────────

model Activity {
  id          String       @id @default(cuid())
  projectId   String
  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type        ActivityType
  title       String
  description String
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  metadata    String?
  createdAt   DateTime     @default(now())

  @@index([projectId])
  @@index([createdAt])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId String?
  project   Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  type      NotificationType
  title     String
  message   String
  read      Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  @@index([userId])
  @@index([read])
}

// ─── Audit Log ─────────────────────────────────────────────────────────────────

model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String
  entityId   String
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  metadata   String?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

// ─── Field crew (personal roster of Field Manager — no login) ─────────────────

model FieldCrewMember {
  id         String   @id @default(cuid())
  managerId  String
  manager    Employee @relation(fields: [managerId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  profession String?
  status     String   @default("active") // active | inactive
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  timeEntries FieldCrewTimeEntry[]
  workOrderLines WorkOrderWorker[]

  @@index([managerId])
  @@index([status])
}

/** Manual timesheet rows entered by foreman for crew (no worker login). */
model FieldCrewTimeEntry {
  id           String          @id @default(cuid())
  crewMemberId String
  crewMember   FieldCrewMember @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)
  /** Denormalized owner for auth / listing */
  managerId    String
  date         DateTime        @db.Date
  startTime    String?
  endTime      String?
  totalHours   Float           @default(0)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([crewMemberId])
  @@index([managerId])
  @@index([date])
  @@index([crewMemberId, date])
}

model FieldAttendance {
  id           String    @id @default(cuid())
  foremanId    String
  foreman      Employee  @relation(fields: [foremanId], references: [id])
  projectId    String?
  project      Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  checkedInAt  DateTime
  checkedOutAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([foremanId])
  @@index([projectId])
  @@index([checkedInAt])
}

/** Office / Operations daily presence (not field foreman attendance) */
model OfficeAttendance {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  checkedInAt    DateTime
  checkedOutAt   DateTime?
  /** qr | nfc | manual */
  source         String?
  latitude       Float?
  longitude      Float?
  accuracyMeters Float?
  ipAddress      String?
  deviceId       String?
  deviceType     String?
  userAgent      String?
  osName           String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([checkedInAt])
  @@index([userId, checkedOutAt])
  @@index([deviceId])
}

/** מכשיר מאושר לנוכחות QR/NFC — נרשם באשף חד-פעמי */
model AttendanceDevice {
  id                String    @id @default(cuid())
  deviceId          String    @unique
  label             String?
  userId            String?
  user              User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  /** Trusted device after one-time enrollment wizard */
  approved          Boolean   @default(false)
  approvedAt        DateTime?
  approvedById      String?
  enrolledAt        DateTime?
  termsAcceptedAt   DateTime?
  selfieUrl         String?   @db.Text
  selfiePath        String?
  selfieBucket      String?
  enrollLatitude    Float?
  enrollLongitude   Float?
  lastSeenAt        DateTime?
  userAgent         String?
  deviceType        String?
  osName              String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([userId])
  @@index([approved])
}

// ─── AI Document Parse ─────────────────────────────────────────────────────────

model AiParseLog {
  id            String    @id @default(cuid())
  documentType  String
  documentId    String?
  projectId     String?
  status        String
  startedAt     DateTime
  endedAt       DateTime?
  durationMs    Int?
  itemsDetected Int       @default(0)
  fieldsMissing Int       @default(0)
  error         String?
  resultJson    String?
  createdById   String
  createdAt     DateTime  @default(now())

  @@index([projectId])
  @@index([documentId])
  @@index([createdAt])
}

// ─── Execution Reports (new reporting system) ────────────────────────────────

enum ExecutionReportStatus {
  draft
  submitted
  approved
  cancelled
}

/**
 * Execution Report - דיווח ביצוע (הדרך החדשה לתעד ביצועים)
 * דיווח אחד יכול לכלול מספר פריטי BOQ
 */
model ExecutionReport {
  id            String                @id @default(cuid())
  reportNumber  String                @unique // דוגמה: "ER-2026-0018"
  sequenceNumber Int                  @default(1)
  projectId     String
  project       Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reportedAt    DateTime              // תאריך הדיווח
  foremanId     String?
  foreman       Employee?             @relation("ReportForeman", fields: [foremanId], references: [id])
  status        ExecutionReportStatus @default(submitted)
  notes         String?               // הערות כלליות לדיווח
  createdById   String
  createdBy     User                  @relation("ExecutionReportCreatedBy", fields: [createdById], references: [id])
  updatedById   String
  updatedBy     User                  @relation("ExecutionReportUpdatedBy", fields: [updatedById], references: [id])
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  items       ExecutionReportItem[]
  media       ExecutionReportMedia[]
  attachments ExecutionReportAttachment[]

  @@index([projectId])
  @@index([reportedAt])
  @@index([foremanId])
  @@index([status])
}

/**
 * Execution Report Item - פריט בתוך דיווח ביצוע
 */
model ExecutionReportItem {
  id           String          @id @default(cuid())
  reportId     String
  report       ExecutionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  boqItemId    String
  boqItem      BoqItem         @relation(fields: [boqItemId], references: [id])
  quantity     Decimal         @db.Decimal(12, 4) // הכמות שבוצעה בדיווח הנוכחי
  invoiced     Boolean         @default(false) // האם פריט זה כבר חויב בחשבון
  invoicedAt   DateTime?       // מתי חויב
  invoiceId    String?         // קישור לחשבון (אם חויב)
  invoice      PartialInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  notes        String?         // הערות ספציפיות לפריט זה
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([reportId])
  @@index([boqItemId])
  @@index([invoiced])
  @@index([invoiceId])
}

/**
 * Execution Report Media - תמונות/סרטונים של דיווח ביצוע
 */
model ExecutionReportMedia {
  id            String          @id @default(cuid())
  reportId      String
  report        ExecutionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type          MediaType
  name          String
  extension     String
  size          Int
  bucket        String
  path          String
  url           String
  thumbnailUrl  String?
  thumbnailPath String?
  createdAt     DateTime        @default(now())

  @@index([reportId])
}

/**
 * Execution Report Attachment - מסמכים של דיווח ביצוע
 */
model ExecutionReportAttachment {
  id        String          @id @default(cuid())
  reportId  String
  report    ExecutionReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name      String
  extension String
  size      Int
  bucket    String
  path      String
  url       String
  createdAt DateTime        @default(now())

  @@index([reportId])
}

// ─── Work Management (סידור / יומן עבודה — מודול חדש) ─────────────────────────

enum WorkOrderStatus {
  draft
  assigned
  in_progress
  completed
  cancelled
}

/**
 * WorkOrder — סידור עבודה יומי של מנהל עבודה
 * מקור אמת לתכנון עובדים/הערות/סטטוס. דיווח כמויות → ExecutionReport.
 */
model WorkOrder {
  id             String          @id @default(cuid())
  orderNumber    String          @unique
  sequenceNumber Int             @default(1)
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  foremanId      String
  foreman        Employee        @relation("WorkOrderForeman", fields: [foremanId], references: [id])
  date           DateTime        @db.Date
  title          String?
  workArea       String?
  clientName     String?
  address        String?
  notes          String?
  status         WorkOrderStatus @default(draft)
  startedAt      DateTime?
  completedAt    DateTime?
  createdById    String
  updatedById    String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  workers WorkOrderWorker[]
  vehicles WorkOrderVehicle[]
  media   WorkOrderMedia[]

  @@index([projectId])
  @@index([foremanId])
  @@index([date])
  @@index([status])
  @@index([foremanId, date])
}

model WorkOrderWorker {
  id           String           @id @default(cuid())
  workOrderId  String
  workOrder    WorkOrder        @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  crewMemberId String?
  crewMember   FieldCrewMember? @relation(fields: [crewMemberId], references: [id], onDelete: SetNull)
  name         String
  role         String?
  startTime    String?
  endTime      String?
  hours        Float            @default(0)
  notes        String?
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([workOrderId])
  @@index([crewMemberId])
}

/** רכב כטקסט חופשי — אין מודל Vehicle במערכת */
model WorkOrderVehicle {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  name        String
  plate       String?
  driverName  String?
  startTime   String?
  endTime     String?
  hours       Float     @default(0)
  notes       String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workOrderId])
}

model WorkOrderMedia {
  id          String    @id @default(cuid())
  workOrderId String
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  kind        String    @default("photo") // photo | document
  name        String
  url         String
  path        String?
  bucket      String?
  size        Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([workOrderId])
}

// ═══════════════════════════════════════════════════════════════════════════
// Work Diary + Ops Delivery Notes — מודול חדש (מחליף סידור עבודה / תעודות)
// Legacy WorkOrder / DeliveryNote נשארים לקריאה בלבד עד מיגרציה.
// ═══════════════════════════════════════════════════════════════════════════

enum WorkDiaryStatus {
  draft
  pending_approval
  in_approval
  approved
  sent_to_client
  signed
  completed
  revision
}

enum OpsDeliveryNoteStatus {
  draft
  pending_approval
  approved
  sent_to_client
  signed
  closed
  revision
}

enum DocApprovalStatus {
  pending
  approved
  rejected
  cancelled
}

enum FieldDocKind {
  work_diary
  delivery_note
}

/** מספור עצמאי WD- / DN- — מספרים לא נמחקים ולא ממוחזרים */
model DocumentNumberSequence {
  id           String   @id @default(cuid())
  documentKind FieldDocKind @unique
  prefix       String
  lastNumber   Int      @default(0)
  updatedAt    DateTime @updatedAt
}

/** מאשרים קבועים לפרויקט (ברירת מחדל בשליחה לאישור) */
model ProjectDefaultApprover {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
}

model WorkDiary {
  id             String          @id @default(cuid())
  documentNumber String          @unique
  sequenceNumber Int
  status         WorkDiaryStatus @default(draft)
  projectId      String
  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientName     String?
  address        String?
  foremanId      String
  foreman        Employee        @relation("WorkDiaryForeman", fields: [foremanId], references: [id])
  workDate       DateTime        @db.Date
  workTime       String?
  weather        String?
  workType       String?
  workSummary    String?
  notes          String?

  /** חתימת מנהל עבודה (data URL / storage URL) */
  foremanSignatureUrl  String?
  foremanSignedAt      DateTime?
  foremanSignedName    String?

  /** חתימת לקוח */
  clientSignatureUrl   String?
  clientSignedName     String?
  clientSignedAt       DateTime?
  clientSignedIp       String?
  clientSignedDevice   String?
  clientSignedVersion  Int?

  signedPdfUrl String?
  lockedAt     DateTime?
  deletedAt    DateTime?

  currentVersion Int @default(1)

  /** מקור אמת לסטטוס/אישור — WorkflowDocument */
  workflowDocumentId String? @unique
  workflowDocument   WorkflowDocument? @relation(fields: [workflowDocumentId], references: [id], onDelete: SetNull)

  createdById String
  createdBy   User     @relation("WorkDiaryCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User     @relation("WorkDiaryUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workItems   WorkDiaryWorkItem[]
  workers     WorkDiaryWorker[]
  equipment   WorkDiaryEquipment[]
  materials   WorkDiaryMaterial[]
  media       WorkDiaryMedia[]
  attachments WorkDiaryAttachment[]
  approvals   WorkDiaryApproval[]
  signTokens  WorkDiarySignToken[]
  events      WorkDiaryEvent[]

  @@index([projectId])
  @@index([foremanId])
  @@index([status])
  @@index([workDate])
  @@index([deletedAt])
}

model WorkDiaryWorkItem {
  id          String    @id @default(cuid())
  workDiaryId String
  workDiary   WorkDiary @relation(fields: [workDiaryId], references: [id], onDelete: Cascade)
  lineNumber  Int       @default(1)
  description String
  unit        String    @default("יח'")
  quantity    Decimal   @default(0) @db.Decimal(12, 4)
  notes       String?
  sortOrder   Int       @default(0)

  @@index([workDiaryId])
}

model WorkDiaryWorker {
  id           String           @id @default(cuid())
  workDiaryId  String
  workDiary    WorkDiary        @relation(fields: [workDiaryId], references: [id], onDelete: Cascade)
  crewMemberId String?
  name         String
  role         String?
  startTime    String?
  endTime      String?
  hours        Float            @default(0)
  sortOrder    Int              @default(0)

  @@index([workDiaryId])
}

model WorkDiaryEquipment {
  id          String    @id @default(cuid())
  workDiaryId String
  workDiary   WorkDiary @relation(fields: [workDiaryId], references: [id], onDelete: Cascade)
  name        String
  quantity    Decimal?  @db.Decimal(12, 4)
  notes       String?
  sortOrder   Int       @default(0)

  @@index([workDiaryId])
}

model WorkDiaryMaterial {
  id          String    @id @default(cuid())
  workDiaryId String
  workDiary   WorkDiary @relation(fields: [workDiaryId], references: [id], onDelete: Cascade)
  name        String
  unit        String    @default("יח'")
  quantity    Decimal   @default(0) @db.Decimal(12, 4)
  notes       String?
  sortOrder   Int       @default(0)

  @@index([workDiaryId])
}

model WorkDiaryMedia {
  id          String    @id @default(cuid())
  workDiaryId String
  workDiary   WorkDiary @relation(fields: [workDiaryId], references: [id], onDelete: Cascade)
  /** before | during | after | other */
  stage       String    @default("other")
  name        String
  url         String
  path        String?
  bucket      String?
  size        Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([workDiaryId])
}

model WorkDiaryAttachment {
  id          String    @id @default(cuid())
  workDiaryId String
  workDiary   WorkDiary @relation(fields: [workDiaryId], references: [id], onDelete: Cascade)
  name        String
  mimeType    String
  size        Int
  kind        String    @default("document")
  bucket      String
  path        String
  url         String
  createdAt   DateTime  @default(now())

  @@index([workDiaryId])
}

model WorkDiaryApproval {
  id          String            @id @default(cuid())
  workDiaryId String
  workDiary   WorkDiary         @relation(fields: [workDiaryId], references: [id], onDelete: Cascade)
  approverId  String
  approver    User              @relation("WorkDiaryApprover", fields: [approverId], references: [id])
  status      DocApprovalStatus @default(pending)
  comment     String?
  sentAt      DateTime          @default(now())
  decidedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([workDiaryId])
  @@index([approverId])
  @@index([status])
}

model WorkDiarySignToken {
  id          String    @id @default(cuid())
  workDiaryId String
  workDiary   WorkDiary @relation(fields: [workDiaryId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  /** short public id in URL path */
  publicId    String    @unique
  expiresAt   DateTime?
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([workDiaryId])
}

model WorkDiaryEvent {
  id          String    @id @default(cuid())
  workDiaryId String
  workDiary   WorkDiary @relation(fields: [workDiaryId], references: [id], onDelete: Cascade)
  action      String
  message     String
  actorId     String?
  actor       User?     @relation("WorkDiaryEventActor", fields: [actorId], references: [id])
  metadata    String?
  createdAt   DateTime  @default(now())

  @@index([workDiaryId])
  @@index([createdAt])
}

model OpsDeliveryNote {
  id             String               @id @default(cuid())
  documentNumber String               @unique
  sequenceNumber Int
  status         OpsDeliveryNoteStatus @default(draft)
  projectId      String?
  project        Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  clientName     String
  address        String?
  foremanId      String
  foreman        Employee             @relation("OpsDnForeman", fields: [foremanId], references: [id])
  noteDate       DateTime             @db.Date
  vehicleNumber  String?
  driverName     String?
  notes          String?

  foremanSignatureUrl String?
  foremanSignedAt     DateTime?
  foremanSignedName   String?

  clientSignatureUrl  String?
  clientSignedName    String?
  clientSignedAt      DateTime?
  clientSignedIp      String?
  clientSignedDevice  String?
  clientSignedVersion Int?

  signedPdfUrl String?
  lockedAt     DateTime?
  deletedAt    DateTime?
  whatsappSentAt DateTime?

  currentVersion Int @default(1)

  createdById String
  createdBy   User     @relation("OpsDnCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User     @relation("OpsDnUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items       OpsDeliveryNoteItem[]
  media       OpsDeliveryNoteMedia[]
  attachments OpsDeliveryNoteAttachment[]
  approvals   OpsDeliveryNoteApproval[]
  signTokens  OpsDeliveryNoteSignToken[]
  events      OpsDeliveryNoteEvent[]

  @@index([projectId])
  @@index([foremanId])
  @@index([status])
  @@index([noteDate])
  @@index([deletedAt])
}

model OpsDeliveryNoteItem {
  id                 String          @id @default(cuid())
  opsDeliveryNoteId  String
  opsDeliveryNote    OpsDeliveryNote @relation(fields: [opsDeliveryNoteId], references: [id], onDelete: Cascade)
  description        String
  unit               String          @default("יח'")
  quantity           Decimal         @db.Decimal(12, 4)
  notes              String?
  sortOrder          Int             @default(0)

  @@index([opsDeliveryNoteId])
}

model OpsDeliveryNoteMedia {
  id                String          @id @default(cuid())
  opsDeliveryNoteId String
  opsDeliveryNote   OpsDeliveryNote @relation(fields: [opsDeliveryNoteId], references: [id], onDelete: Cascade)
  /** loading | transport | unloading | other */
  stage             String          @default("other")
  name              String
  url               String
  path              String?
  bucket            String?
  size              Int             @default(0)
  createdAt         DateTime        @default(now())

  @@index([opsDeliveryNoteId])
}

model OpsDeliveryNoteAttachment {
  id                String          @id @default(cuid())
  opsDeliveryNoteId String
  opsDeliveryNote   OpsDeliveryNote @relation(fields: [opsDeliveryNoteId], references: [id], onDelete: Cascade)
  name              String
  mimeType          String
  size              Int
  kind              String          @default("document")
  bucket            String
  path              String
  url               String
  createdAt         DateTime        @default(now())

  @@index([opsDeliveryNoteId])
}

model OpsDeliveryNoteApproval {
  id                String            @id @default(cuid())
  opsDeliveryNoteId String
  opsDeliveryNote   OpsDeliveryNote   @relation(fields: [opsDeliveryNoteId], references: [id], onDelete: Cascade)
  approverId        String
  approver          User              @relation("OpsDnApprover", fields: [approverId], references: [id])
  status            DocApprovalStatus @default(pending)
  comment           String?
  sentAt            DateTime          @default(now())
  decidedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([opsDeliveryNoteId])
  @@index([approverId])
  @@index([status])
}

model OpsDeliveryNoteSignToken {
  id                String          @id @default(cuid())
  opsDeliveryNoteId String
  opsDeliveryNote   OpsDeliveryNote @relation(fields: [opsDeliveryNoteId], references: [id], onDelete: Cascade)
  tokenHash         String          @unique
  publicId          String          @unique
  expiresAt         DateTime?
  usedAt            DateTime?
  revokedAt         DateTime?
  createdById       String?
  createdAt         DateTime        @default(now())

  @@index([opsDeliveryNoteId])
}

model OpsDeliveryNoteEvent {
  id                String          @id @default(cuid())
  opsDeliveryNoteId String
  opsDeliveryNote   OpsDeliveryNote @relation(fields: [opsDeliveryNoteId], references: [id], onDelete: Cascade)
  action            String
  message           String
  actorId           String?
  actor             User?           @relation("OpsDnEventActor", fields: [actorId], references: [id])
  metadata          String?
  createdAt         DateTime        @default(now())

  @@index([opsDeliveryNoteId])
  @@index([createdAt])
}

// ─── Measurement Sheets (דפי מדידה → חשבונות) ────────────────────────────────

model MeasurementSheet {
  id               String                 @id @default(cuid())
  projectId        String
  project          Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  sequenceNumber   Int                    @default(1)
  status           MeasurementSheetStatus @default(draft)
  notes            String?
  /** גרסת מסמך — עולה בכל שליחה לאישור */
  currentVersion   Int                    @default(1)
  submittedAt      DateTime?
  approvedAt       DateTime?
  returnedAt       DateTime?
  lastReturnComment String?               @db.Text
  partialInvoiceId String?
  partialInvoice   PartialInvoice?        @relation(fields: [partialInvoiceId], references: [id], onDelete: SetNull)
  clientSignatureUrl  String?
  clientSignedName    String?
  clientSignedAt      DateTime?
  clientSignedIp      String?
  clientSignedDevice  String?
  createdById      String
  createdBy        User                   @relation("MeasurementSheetCreatedBy", fields: [createdById], references: [id])
  updatedById      String
  updatedBy        User                   @relation("MeasurementSheetUpdatedBy", fields: [updatedById], references: [id])
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  rows        MeasurementSheetRow[]
  cells       MeasurementCell[]
  entries     MeasurementEntry[]
  approvals   MeasurementSheetApproval[]
  events      MeasurementSheetEvent[]
  reviewNotes MeasurementSheetReviewNote[]
  versions    MeasurementSheetVersion[]
  signTokens  MeasurementSheetSignToken[]

  @@unique([projectId, sequenceNumber])
  @@index([projectId])
  @@index([status])
  @@index([partialInvoiceId])
}

model MeasurementSheetSignToken {
  id          String           @id @default(cuid())
  sheetId     String
  sheet       MeasurementSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  tokenHash   String           @unique
  publicId    String           @unique
  expiresAt   DateTime?
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String?
  createdAt   DateTime         @default(now())

  @@index([sheetId])
}

model MeasurementSheetApproval {
  id          String            @id @default(cuid())
  sheetId     String
  sheet       MeasurementSheet  @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  approverId  String
  approver    User              @relation("MeasurementSheetApprover", fields: [approverId], references: [id])
  status      DocApprovalStatus @default(pending)
  comment     String?
  sentAt      DateTime          @default(now())
  decidedAt   DateTime?
  createdAt   DateTime          @default(now())

  @@index([sheetId])
  @@index([approverId])
  @@index([status])
}

model MeasurementSheetReviewNote {
  id         String           @id @default(cuid())
  sheetId    String
  sheet      MeasurementSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  /** חדר / יחידה */
  rowId      String?
  /** סעיף BOQ */
  boqItemId  String?
  comment    String
  version    Int              @default(1)
  authorId   String
  author     User             @relation("MeasurementSheetReviewAuthor", fields: [authorId], references: [id])
  createdAt  DateTime         @default(now())

  @@index([sheetId])
  @@index([rowId])
  @@index([boqItemId])
}

model MeasurementSheetEvent {
  id        String           @id @default(cuid())
  sheetId   String
  sheet     MeasurementSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  type      String
  message   String
  metadata  String?
  actorId   String
  actor     User             @relation("MeasurementSheetEventActor", fields: [actorId], references: [id])
  createdAt DateTime         @default(now())

  @@index([sheetId])
  @@index([createdAt])
}

model MeasurementSheetVersion {
  id           String           @id @default(cuid())
  sheetId      String
  sheet        MeasurementSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  version      Int
  status       MeasurementSheetStatus
  /** JSON snapshot of sheet after this version */
  snapshotJson String           @default("{}")
  note         String?
  actorId      String
  createdAt    DateTime         @default(now())

  @@unique([sheetId, version])
  @@index([sheetId])
}

model MeasurementSheetRow {
  id        String           @id @default(cuid())
  sheetId   String
  sheet     MeasurementSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int              @default(0)
  notes     String?
  /** קישור לחדר ברמת פרויקט (מקור אמת) */
  projectRoomId String?
  projectRoom   ProjectRoom? @relation(fields: [projectRoomId], references: [id], onDelete: SetNull)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  cells MeasurementCell[]

  @@index([sheetId])
  @@index([projectRoomId])
}

model MeasurementCell {
  id          String              @id @default(cuid())
  sheetId     String
  sheet       MeasurementSheet    @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  rowId       String
  row         MeasurementSheetRow @relation(fields: [rowId], references: [id], onDelete: Cascade)
  boqItemId   String
  boqItem     BoqItem             @relation(fields: [boqItemId], references: [id])
  quantity    Decimal             @default(0) @db.Decimal(12, 4)
  updatedAt   DateTime            @updatedAt
  createdAt   DateTime            @default(now())

  entries MeasurementEntry[]

  @@unique([rowId, boqItemId])
  @@index([sheetId])
  @@index([boqItemId])
}

model MeasurementEntry {
  id          String           @id @default(cuid())
  sheetId     String
  sheet       MeasurementSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  cellId      String?
  cell        MeasurementCell? @relation(fields: [cellId], references: [id], onDelete: SetNull)
  boqItemId   String?
  rowId       String?
  oldQuantity Decimal?         @db.Decimal(12, 4)
  newQuantity Decimal          @db.Decimal(12, 4)
  note        String?
  actorId     String
  actor       User             @relation("MeasurementEntryActor", fields: [actorId], references: [id])
  createdAt   DateTime         @default(now())

  @@index([sheetId])
  @@index([cellId])
  @@index([createdAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// Central Workflow Engine — מקור אמת לסטטוס / אישורים / Audit / גרסאות
// Stage 1: תשתית בלבד. מודולים (יומן / סידור / מדידה) יתחברו בשלבים הבאים.
// ═══════════════════════════════════════════════════════════════════════════

enum WorkflowDocKind {
  WORK_DIARY
  DELIVERY_NOTE
  EXECUTION_REPORT
  MEASUREMENT
  ACCOUNT
  INVOICE
  WORK_SCHEDULE
  GENERAL
}

enum WorkflowStatus {
  draft
  pending_approval
  revision
  approved
  sent_to_client
  client_signed
  sent_to_receiver
  receiver_signed
  used_for_measurement
  used_for_account
  used_for_invoice
  locked
  cancelled
}

enum ClientSignatureStatus {
  none
  pending
  opened
  signed
  expired
}

enum WorkflowApprovalStatus {
  pending
  approved
  rejected
  cancelled
}

/** מסמך לוגי במנוע ה-Workflow — מספר ייחודי נשמר לכל החיים (למשל JW-000125) */
model WorkflowDocument {
  id                    String                @id @default(cuid())
  kind                  WorkflowDocKind
  /** מספר מסמך קבוע — לא משתנה בין סטטוסים */
  documentNumber        String
  projectId             String
  project               Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                 String?
  status                WorkflowStatus        @default(draft)
  version               Int                   @default(1)
  currentOwnerId        String?
  currentOwner          User?                 @relation("WorkflowDocumentOwner", fields: [currentOwnerId], references: [id])
  clientSignatureStatus ClientSignatureStatus @default(none)
  /** שרשרת מסמכים — מקור / הורה / הבא (ימולא בשלבים הבאים) */
  sourceDocumentId      String?
  sourceDocument        WorkflowDocument?     @relation("WorkflowSource", fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  derivedDocuments      WorkflowDocument[]    @relation("WorkflowSource")
  parentDocumentId      String?
  parentDocument        WorkflowDocument?     @relation("WorkflowParent", fields: [parentDocumentId], references: [id], onDelete: SetNull)
  childDocuments        WorkflowDocument[]    @relation("WorkflowParent")
  nextDocumentId        String?
  nextDocument          WorkflowDocument?     @relation("WorkflowNext", fields: [nextDocumentId], references: [id], onDelete: SetNull)
  prevDocuments         WorkflowDocument[]    @relation("WorkflowNext")
  /** קישור לישות תוכן (WorkDiary / …) בזמן מיגרציה */
  legacyEntityType      String?
  legacyEntityId        String?
  /** דגלים / מטא-דאטה (JSON) */
  metadataJson          String?
  createdById           String
  createdBy             User                  @relation("WorkflowDocumentCreatedBy", fields: [createdById], references: [id])
  updatedById           String
  updatedBy             User                  @relation("WorkflowDocumentUpdatedBy", fields: [updatedById], references: [id])
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  approvals   WorkflowApproval[]
  events      WorkflowEvent[]
  overrides   WorkflowOverride[]
  versions    WorkflowDocVersion[]
  attachments WorkflowAttachment[]
  workDiary   WorkDiary?
  archiveDocument Document?

  @@unique([kind, documentNumber])
  @@index([projectId])
  @@index([status])
  @@index([kind, status])
  @@index([sourceDocumentId])
  @@index([parentDocumentId])
  @@index([nextDocumentId])
  @@index([legacyEntityType, legacyEntityId])
  @@index([currentOwnerId])
}

model WorkflowApproval {
  id           String                 @id @default(cuid())
  documentId   String
  document     WorkflowDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approverId   String
  approver     User                   @relation("WorkflowApprover", fields: [approverId], references: [id])
  status       WorkflowApprovalStatus @default(pending)
  comment      String?
  sentAt       DateTime               @default(now())
  decidedAt    DateTime?
  createdAt    DateTime               @default(now())

  @@index([documentId])
  @@index([approverId])
  @@index([status])
}

/** Audit + Timeline — אין מחיקה לוגית של רשומות אלה מהאפליקציה */
model WorkflowEvent {
  id         String           @id @default(cuid())
  documentId String
  document   WorkflowDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  type       String
  message    String
  fromStatus WorkflowStatus?
  toStatus   WorkflowStatus?
  metadata   String?
  actorId    String?
  actor      User?            @relation("WorkflowEventActor", fields: [actorId], references: [id])
  createdAt  DateTime         @default(now())

  @@index([documentId, createdAt])
  @@index([type])
}

model WorkflowOverride {
  id         String           @id @default(cuid())
  documentId String
  document   WorkflowDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  reason     String
  note       String
  fromStatus WorkflowStatus
  toStatus   WorkflowStatus
  actorId    String
  actor      User             @relation("WorkflowOverrideActor", fields: [actorId], references: [id])
  createdAt  DateTime         @default(now())

  @@index([documentId])
  @@index([actorId])
  @@index([createdAt])
}

model WorkflowDocVersion {
  id           String           @id @default(cuid())
  documentId   String
  document     WorkflowDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version      Int
  status       WorkflowStatus
  snapshotJson String           @default("{}")
  note         String?
  actorId      String?
  createdAt    DateTime         @default(now())

  @@unique([documentId, version])
  @@index([documentId])
}

model WorkflowAttachment {
  id           String           @id @default(cuid())
  documentId   String
  document     WorkflowDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  name         String
  /** סיווג קובץ: image | video | pdf | … */
  fileType     String
  extension    String
  size         Int
  bucket       String
  path         String
  url          String
  uploadedById String
  uploadedBy   User             @relation("WorkflowAttachmentUploadedBy", fields: [uploadedById], references: [id])
  createdAt    DateTime         @default(now())

  @@index([documentId])
  @@index([fileType])
}

/**
 * קישור שיתוף חיצוני מאובטח — כללי לכל ישות (מסמך, חשבון, דף מדידה…).
 * רק מנהל מערכת יוצר; צפייה ללא Login.
 */
model ExternalShareLink {
  id           String    @id @default(cuid())
  /** document | invoice | measurement_sheet | work_diary | delivery_note | other */
  entityType   String
  entityId     String
  projectId    String?
  title        String?
  tokenHash    String    @unique
  publicId     String    @unique
  expiresAt    DateTime?
  revokedAt    DateTime?
  viewCount    Int       @default(0)
  lastViewedAt DateTime?
  createdById  String
  notes        String?
  createdAt    DateTime  @default(now())

  @@index([entityType, entityId])
  @@index([projectId])
  @@index([createdById])
}
